SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

WA_AUTH_PATH=.wwebjs_auth
WA_TRANSCRIPT_LIMIT=20
WA_INTERNAL_NOTIFY_CHAT_ID=your-internal-group-chat-id

# AI Provider: 'gemini' or 'ollama'
AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-preview

# Ollama (alternative to Gemini)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Gmail
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
GMAIL_FROM=your-email@gmail.com
GMAIL_TO=recipient1@email.com,recipient2@email.com

# Jira (DEPRECATED - kept for reference only, not used)
# JIRA_BASE_URL=https://your-team.atlassian.net
# JIRA_EMAIL=your-email@email.com
# JIRA_API_TOKEN=your-api-token
# JIRA_PROJECT_KEY=PROJECT
# JIRA_ASSIGNEE_Phuc_ID=your-account-id
# JIRA_ASSIGNEE_Vy_ID=your-account-id
# JIRA_ASSIGNEE_Tram_ID=your-account-id

VIP_MODE=allow_all
